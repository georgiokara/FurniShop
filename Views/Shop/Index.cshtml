@model List<Product>
@{
    ViewData["Title"] = "Shop";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selected = ViewBag.SelectedCategory as string;
}

<div class="hero">
    <div class="container">
        <div class="row justify-content-between">
            <div class="col-lg-5">
                <div class="intro-excerpt">
                    <h1>Shop</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="untree_co-section product-section before-footer-section">
    <div class="container">

        @if (categories.Count > 0)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-sm @(selected == null ? "btn-black" : "btn-outline-black") me-2">All</a>
                    @foreach (var cat in categories)
                    {
                        <a asp-action="Index" asp-route-category="@cat" class="btn btn-sm @(selected == cat ? "btn-black" : "btn-outline-black") me-2">@cat</a>
                    }
                </div>
            </div>
        }

        <div class="row">
            @if (Model.Count == 0)
            {
                <p>No products in this category yet.</p>
            }
            @foreach (var product in Model)
            {
                <div class="col-12 col-md-4 col-lg-3 mb-5">
                    <div class="product-item">
                        <img src="~/@product.ImageUrl" class="img-fluid product-thumbnail" alt="@product.Name">
                        <h3 class="product-title">@product.Name</h3>
                        <strong class="product-price">@product.Price.ToString("C")</strong>

                        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-2 d-flex align-items-center gap-2">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="number" name="quantity" value="1" min="1" class="form-control form-control-sm" style="width:70px;" />
                            <button type="submit" class="btn btn-black btn-sm">Add to Cart</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
